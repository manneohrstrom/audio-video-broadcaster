# Hub control service and web UI on port 80, as user studio (not root).
[Unit]
Description=hubd studio hub control
After=network-online.target
Wants=network-online.target

[Service]
User=studio
Group=studio
Environment=HUBD_CONFIG=/etc/hubd/config.json
# Few malloc arenas: with many threads (HTTP requests, the calibration watcher) glibc kept
# freed memory per thread and hubd grew past 1 GB within the hour (2026-11-16).
Environment=MALLOC_ARENA_MAX=2
ExecStart=/usr/bin/python3 -u /opt/hubd/hubd.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
