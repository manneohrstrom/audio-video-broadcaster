# Ingest worker: pulls, conforms, verifies and writes takes to the STUDIO drive.
# Separate from hubd so a crash or a long encode can never affect REC/LIVE.
[Unit]
Description=hub-ingest studio take ingest
After=network-online.target hubd.service
Wants=network-online.target

[Service]
User=studio
Group=studio
Environment=INGEST_CONFIG=/etc/hubd/ingest.json
ExecStart=/usr/bin/python3 -u /opt/hub-ingest/ingest.py
Restart=on-failure
RestartSec=5
# An encode can take ~1 h; give the current step time to stop cleanly.
TimeoutStopSec=30
# A hard memory limit for ingest and everything it starts (renders, proxies, thumbnails).
# 2026-11-16 a render ran the 1 GB hub so short of memory that it froze until power-cycled.
# With the limit the kernel stops the render (render processes have oom_score_adj 1000)
# inside this group, and hubd, the cameras' control and the page keep running.
# Needs cgroup_enable=memory on the kernel command line (deploy/roles/hub_ingest; without
# it, until 2026-11-28, these two lines did nothing).
MemoryMax=700M
# Swap: zram first (compressed RAM), then the 2 GB overflow file on the SD card
# (deploy/roles/hub_ingest), so a render that needs more slows down instead of being killed
# (user, 2026-11-28). During a dissolve a render holds the encoder (~390 MB with a light look),
# two camera decoders (~137 MB each) and ingest (~95 MB), ~760 MB in all: 64 MB of swap
# killed it at the first dissolve; 256 MB passed a 30 s test. 1 GB leaves a margin for
# heavier looks, at the cost of speed once it reaches the card.
MemorySwapMax=1G
# When the kernel kills a process here for memory (the render's encoder or a decoder:
# oom_score_adj 1000), keep the service running so the render fails with its error. The
# default, stop, killed all of ingest, and on restart it queued the same render again: a loop.
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
